# Netlify / Cloudflare Pages response headers.
# The script-src hash covers the inline theme script in index.html; if that
# script changes by even one byte, recompute it (see README) or the theme
# script is blocked.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-oD4je1uiiFeTSbayIbnf1/WWq2yVwi3G/A4K/OFyJ5Q='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
